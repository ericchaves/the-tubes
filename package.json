{
  "name": "the-tubes",
  "version": "1.0.0",
  "description": "Expose local services to the world — unified tunnel server, client and replay",
  "type": "module",
  "bin": {
    "tt": "bin/tt.js"
  },
  "engines": {
    "node": ">=25.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "start": "node bin/tt.js",
    "test": "node --test 'test/unit/**/*.test.js' 'test/integration/**/*.test.js'",
    "test:unit": "node --test 'test/unit/**/*.test.js'",
    "test:integration": "node --test 'test/integration/**/*.test.js'",
    "test:regression": "node --test 'test/regression/**/*.test.js'",
    "test:e2e": "node --test 'test/e2e/**/*.test.js'",
    "test:all": "node --test 'test/unit/**/*.test.js' 'test/integration/**/*.test.js' 'test/regression/**/*.test.js' 'test/e2e/**/*.test.js'"
  },
  "license": "MIT",
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "nunjucks": "^3.2.4",
    "yaml": "^2.9.0"
  }
}
