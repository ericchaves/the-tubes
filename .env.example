# the tubes Configuration
# Copy to .env and customize. All variables are optional unless noted.
# Use with: node bin/tt.js serve --env-file .env

# ── serve mode ──────────────────────────────────────────────────────────────
# TT_PUBLIC_PORT=80
# TT_PUBLIC_ADDRESS=0.0.0.0
# TT_PUBLIC_DOMAIN=tunnel.example.com
# TT_PUBLIC_HTTPS=false
# TT_EXTERNAL_HTTP_PORT=80
# TT_EXTERNAL_HTTPS_PORT=443
# TT_LANDING_URL=https://example.com
# TT_API_PORT=9000
# TT_API_ADDRESS=0.0.0.0
# TT_TUNNEL_PORT_START=10000
# TT_TUNNEL_PORT_END=10100
# TT_MAX_CONNECTIONS_PER_TUNNEL=10
# TT_RECONNECT_WINDOW_MS=30000
# TT_TRUST_FORWARD_HEADERS=false
# TT_HTTP_WAIT_TIMEOUT_MS=5000
# TT_WEBSOCKET_WAIT_TIMEOUT_MS=10000
# TT_RETRY_AFTER_SECONDS=5
# TT_HMAC_SECRET=your-secret-at-least-32-chars-long
# TT_HMAC_SECRET_FILE=/run/secrets/hmac_secret
# TT_HMAC_CLOCK_SKEW_TOLERANCE_S=60

# ── expose mode ──────────────────────────────────────────────────────────────
# TT_LOCAL_PORT=3000
# TT_LOCAL_ADDRESS=localhost
# TT_LOCAL_TLS=false
# TT_LOCAL_TLS_CERT=
# TT_LOCAL_TLS_KEY=
# TT_LOCAL_TLS_CA=
# TT_ALLOW_INSECURE_LOCAL_TLS=false
# TT_REWRITE_HOST_HEADER=true
# TT_SERVER_URL=https://tunnel.example.com:9000
# TT_TUNNEL_SUBDOMAIN=
# TT_SESSION_TOKEN=
# TT_EPHEMERAL=false
# TT_SESSION_FILE=~/.tt/session
# TT_OPEN_BROWSER=false
# TT_LOG_REQUESTS=false
# TT_CAPTURE_DIR=
# TT_CAPTURE_MAX_BODY_KB=1024
# TT_RECONNECT_LOCAL=true
# TT_RECONNECT_LOOP_WINDOW_S=60
# TT_RECONNECT_LOOP_MAX=10

# ── replay mode ──────────────────────────────────────────────────────────────
# TT_REPLAY_MANIFEST=./flows/onboarding.yaml
# TT_REPLAY_TARGET_URL=http://localhost:3000/webhook
